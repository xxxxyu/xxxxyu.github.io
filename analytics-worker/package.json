{
  "name": "xiangyu-site-analytics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var ALLOW_LOCALHOST:true",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "smoke": "node scripts/smoke.js",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
